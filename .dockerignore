# Build context is the repo root (the npm workspace lockfile lives here).
# Keep secrets and everything the images don't need out of it.

# Secrets — "**/" matters: a bare ".env" only matches the root folder,
# which is how apps/api/.env used to end up inside the image.
**/.env
**/.env.*
!**/.env.example

# Installed / built output (rebuilt inside the image)
**/node_modules
**/.next
**/dist
**/*.tsbuildinfo
**/*.log
coverage

# Not part of the web/api images
apps/mobile
deploy
web
.git
.github
.claude
.vscode
.idea
.scratch_verify
README.md
banner.png
