# Copy to /opt/nimbo/.env on the VPS, fill in, then: chmod 600 .env
# Generate random secrets with:  openssl rand -hex 32

# ── Images (written by you once; CI only pulls) ─────────────────────────────────
# ghcr.io/<github-user-or-org, lowercase>
IMAGE_PREFIX=ghcr.io/kinghatrung
# Pin a commit SHA here to roll back one service, e.g. API_TAG=3f2a1bc…  (default: latest)
API_TAG=latest
WEB_TAG=latest

# ── Redis (container on this VPS) ───────────────────────────────────────────────
# hex only: it is embedded in the redis:// URL
REDIS_PASSWORD=

# ── API ─────────────────────────────────────────────────────────────────────────
CLIENT_URL=https://chat.kun.io.vn
MONGODB_CONNECT_URL=mongodb+srv://USER:PASSWORD@huduchat.yga0tdo.mongodb.net/?retryWrites=true&w=majority

JWT_ACCESS_TOKEN=
JWT_REFRESH_TOKEN=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hudu-chat/attachments

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# npx web-push generate-vapid-keys  (the public key also goes to the GitHub variable
# NEXT_PUBLIC_VAPID_PUBLIC_KEY, because the web build bakes it into the bundle)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@kun.io.vn

# Bearer token for GET /api/metrics (leave empty to keep metrics closed)
METRICS_TOKEN=
